+// TEST-ONLY injection hook for algod-rust issue #2400 (ops/mixed-cluster
+// upgradeprop-nonutf8 case). This file is NOT part of go-algorand: it is added
+// by ops/mixed-cluster/upgradeprop-inject/inject.patch to a throwaway build of
+// v5.1.1-stable that only go-node-1 of the mixed cluster runs. With
+// ALGOD_TEST_INJECT_UPGRADEPROP_HEX unset it changes nothing.
+
+package bookkeeping
+
+import (
+	"encoding/hex"
+	"os"
+	"strconv"
+	"sync"
+
+	"github.com/algorand/go-algorand/config"
+	"github.com/algorand/go-algorand/data/basics"
+	"github.com/algorand/go-algorand/logging"
+	"github.com/algorand/go-algorand/protocol"
+)
+
+type upgradePropInjection struct {
+	propose     protocol.ConsensusVersion
+	from, until basics.Round // inject for rounds in [from, until)
+	enabled     bool
+}
+
+var (
+	upgradePropInjectionOnce sync.Once
+	upgradePropInjectionCfg  upgradePropInjection
+)
+
+func loadUpgradePropInjection() upgradePropInjection {
+	upgradePropInjectionOnce.Do(func() {
+		h := os.Getenv("ALGOD_TEST_INJECT_UPGRADEPROP_HEX")
+		if h == "" {
+			return
+		}
+		raw, err := hex.DecodeString(h)
+		if err != nil || len(raw) == 0 {
+			logging.Base().Errorf("upgradeprop-inject: bad ALGOD_TEST_INJECT_UPGRADEPROP_HEX %q: %v", h, err)
+			return
+		}
+		from, _ := strconv.ParseUint(os.Getenv("ALGOD_TEST_INJECT_UPGRADEPROP_FROM"), 10, 64)
+		until, err := strconv.ParseUint(os.Getenv("ALGOD_TEST_INJECT_UPGRADEPROP_UNTIL"), 10, 64)
+		if err != nil || until == 0 {
+			until = ^uint64(0)
+		}
+		upgradePropInjectionCfg = upgradePropInjection{
+			propose: protocol.ConsensusVersion(raw),
+			from:    basics.Round(from),
+			until:   basics.Round(until),
+			enabled: true,
+		}
+	})
+	return upgradePropInjectionCfg
+}
+
+// injectedUpgradeVote returns the test-injected proposal for round, if any.
+// It is consulted only where go itself would propose (no pending proposal),
+// so the resulting vote is one applyUpgradeVote accepts: any byte string of at
+// most MaxVersionStringLen bytes, with a delay inside the permitted range.
+func injectedUpgradeVote(round basics.Round, params config.ConsensusParams) (UpgradeVote, bool) {
+	cfg := loadUpgradePropInjection()
+	if !cfg.enabled || round < cfg.from || round >= cfg.until {
+		return UpgradeVote{}, false
+	}
+	logging.Base().Warnf("upgradeprop-inject: proposing upgradeprop %x for round %d", []byte(cfg.propose), round)
+	return UpgradeVote{
+		UpgradePropose: cfg.propose,
+		UpgradeDelay:   basics.Round(params.MinUpgradeWaitRounds),
+		UpgradeApprove: true,
+	}, true
+}
