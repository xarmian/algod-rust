Issue #2400: TEST-ONLY patch on go-algorand v5.1.1-stable (applied by the
Dockerfile next to it, never to the reference checkout). It lets the block
proposer put the bytes of ALGOD_TEST_INJECT_UPGRADEPROP_HEX into upgradeprop
for rounds in [ALGOD_TEST_INJECT_UPGRADEPROP_FROM, ..._UNTIL) when no upgrade
is pending. Unset, the hook is inert. git apply ignores this preamble.

diff --git a/data/bookkeeping/block.go b/data/bookkeeping/block.go
index 3452fcb72..f129d029e 100644
--- a/data/bookkeeping/block.go
+++ b/data/bookkeeping/block.go
@@ -570,6 +570,10 @@ func ProcessUpgradeParams(prev BlockHeader) (uv UpgradeVote, us UpgradeState, er
 			upgradeVote.UpgradeApprove = true
 			break
 		}
+		// algod-rust #2400 test-only hook, inert unless its env is set.
+		if v, ok := injectedUpgradeVote(prev.Round+1, prevParams); ok {
+			upgradeVote = v
+		}
 	}
 
 	// If there is a proposal being voted on, see if we approve it
