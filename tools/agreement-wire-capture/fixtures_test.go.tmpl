		}},
		{"step_recovery_5", "recovery step 5", rawVote{
			Sender: arfAddr(0x06), Round: basics.Round(1), Period: period(3), Step: step(5), Proposal: pvB,
		}},
		{"round_small", "round 100", rawVote{
			Sender: arfAddr(0x07), Round: basics.Round(100), Period: period(0), Step: step(1), Proposal: pvA,
		}},
