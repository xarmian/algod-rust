// arfAddr builds a deterministic 32-byte basics.Address from a single seed byte.
func arfAddr(seed byte) basics.Address {
	var a basics.Address
	for i := range a {
		a[i] = seed
	}
	return a
}

// arfDigest fills a 32-byte digest with `seed` in every byte.
func arfDigest(seed byte) crypto.Digest {
	var d crypto.Digest
	for i := range d {
		d[i] = seed
	}
	return d
}

// arfVrfProof fills an 80-byte VRF proof with a repeating pattern seeded
// by `seed`. Values are not cryptographically valid — we only need a
// deterministic byte pattern for canonical msgpack.
func arfVrfProof(seed byte) crypto.VrfProof {
	var p crypto.VrfProof
	for i := range p {
		p[i] = byte((int(seed) + i) & 0xff)
	}
	return p
}

// arfVrfOutput fills a 64-byte VRF output similarly.
func arfVrfOutput(seed byte) crypto.VrfOutput {
	var o crypto.VrfOutput
	for i := range o {
		o[i] = byte((int(seed) + i) & 0xff)
	}
	return o
}

// arfOneTimeSig produces a deterministic OneTimeSignature with all
// inner fields populated. It's not a valid signature, but the msgpack
// shape is identical to a real one — that's what the fixture is
// probing.
func arfOneTimeSig(seed byte) crypto.OneTimeSignature {
	var sig crypto.OneTimeSignature
	for i := range sig.Sig {
		sig.Sig[i] = byte((int(seed) + i) & 0xff)
	}
	for i := range sig.PK {
		sig.PK[i] = byte((int(seed) + 0x40 + i) & 0xff)
	}
	for i := range sig.PKSigOld {
		sig.PKSigOld[i] = byte((int(seed) + 0x80 + i) & 0xff)
	}
	for i := range sig.PK2 {
		sig.PK2[i] = byte((int(seed) + 0xc0 + i) & 0xff)
	}
	for i := range sig.PK1Sig {
		sig.PK1Sig[i] = byte((int(seed) + 0x20 + i) & 0xff)
	}
	for i := range sig.PK2Sig {
		sig.PK2Sig[i] = byte((int(seed) + 0x60 + i) & 0xff)
	}
	return sig
}

// arfUnauthCred produces a deterministic UnauthenticatedCredential.
func arfUnauthCred(seed byte) committee.UnauthenticatedCredential {
	return committee.UnauthenticatedCredential{Proof: arfVrfProof(seed)}
}

// arfCred produces a deterministic authenticated Credential.
// `Weight` is the only field we set; VrfOut / Hashable / Selected
// mirror a fixed nonzero stake so the msgpack shape matches a real vote.
func arfCred(seed byte, weight uint64) committee.Credential {
	return committee.Credential{
		UnauthenticatedCredential: arfUnauthCred(seed),
		VrfOut:                    arfDigest(seed ^ 0x5a),
		Weight:                    weight,
		// Selected / DomainSeparationEnabled are zero-value; they're
		// either `codec:"-"` or omitempty in msgp_gen.go — verify by
		// inspection if the shape ever drifts.
	}
}

// arfProposalValue builds a deterministic non-bottom proposalValue.
// `seed` varies the inner digests; passing 0 to all fields produces
// the canonical bottom proposal (zero-value).
func arfProposalValue(originalPeriod period, origProposer byte, block byte, enc byte) proposalValue {
	return proposalValue{
		OriginalPeriod:   originalPeriod,
		OriginalProposer: arfAddr(origProposer),
		BlockDigest:      arfDigest(block),
		EncodingDigest:   arfDigest(enc),
	}
}

// writeFixture encodes `v` and writes both the raw msgpack bytes and a
// JSON metadata sidecar.
func writeFixture(t *testing.T, dir, subdir, name, doc string, v interface{}) {
	t.Helper()
	full := filepath.Join(dir, subdir)
	if err := os.MkdirAll(full, 0o755); err != nil {
		t.Fatalf("mkdir %s: %v", full, err)
	}

	// protocol.Encode takes an interface; the underlying types all
	// implement it via msgp_gen.go. We pass a pointer where required.
	// `*Certificate` is listed distinctly from `*unauthenticatedBundle`
	// so cert fixtures go through Certificate's own encoder path —
	// today the wire bytes match (Certificate is `type Certificate
	// unauthenticatedBundle`), but if go-algorand ever adds
	// Certificate-specific codec behavior, this test would catch it
	// rather than silently skipping over it via a named-type cast.
	// Also keeps the sidecar metadata honest (`*agreement.Certificate`
	// instead of `*agreement.unauthenticatedBundle`) — Codex P2 on
	// PR #228 r6.
	var encoded []byte
	switch x := v.(type) {
	case *rawVote:
		encoded = protocol.Encode(x)
	case *unauthenticatedVote:
		encoded = protocol.Encode(x)
	case *vote:
		encoded = protocol.Encode(x)
	case *unauthenticatedBundle:
		encoded = protocol.Encode(x)
	case *bundle:
		encoded = protocol.Encode(x)
	case *Certificate:
		encoded = protocol.Encode(x)
	case *unauthenticatedProposal:
		encoded = protocol.Encode(x)
	case *proposal:
		encoded = protocol.Encode(x)
	case *transmittedPayload:
		encoded = protocol.Encode(x)
	case *proposalValue:
		encoded = protocol.Encode(x)
	default:
		t.Fatalf("writeFixture %q: unsupported type %T", name, v)
	}

	msgpackPath := filepath.Join(full, name+".msgpack")
	if err := os.WriteFile(msgpackPath, encoded, 0o644); err != nil {
		t.Fatalf("write %s: %v", msgpackPath, err)
	}

	meta := map[string]interface{}{
		"name":       name,
		"type":       fmt.Sprintf("%T", v),
		"doc":        doc,
		"byte_count": len(encoded),
		"hex_head":   hex.EncodeToString(encoded[:min(32, len(encoded))]),
		"source":     "algod-rust/tools/agreement-wire-capture (TASK-54)",
	}
	metaJSON, err := json.MarshalIndent(meta, "", "  ")
	if err != nil {
		t.Fatalf("marshal meta %s: %v", name, err)
	}
	metaJSON = append(metaJSON, '\n')
	metaPath := filepath.Join(full, name+".json")
	if err := os.WriteFile(metaPath, metaJSON, 0o644); err != nil {
		t.Fatalf("write %s: %v", metaPath, err)
	}
}

// TestAlgodRustGenerateWireFixtures is the entry point invoked by
// `tools/agreement-wire-capture`'s wrapper. It's a no-op when
// ALGOD_RUST_WIRE_FIXTURE_DIR is unset, so a normal `go test ./...`
