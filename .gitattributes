# Fixture files are compared byte-for-byte against go-algorand reference
# output (include_str!/include_bytes! golden tests, conformance corpora).
# They must reach the working tree with their exact committed bytes on
# every platform: Windows checkouts with core.autocrlf=true would
# otherwise rewrite LF to CRLF and break the golden tests
# (e.g. algo-rest-api block_json_test).
crates/**/fixtures/** text=auto eol=lf

# BIP-39 wordlist: parsed by index and compared against known checksums
# (see algo_consensus_crypto::passphrase::wordlist). Not under a
# `fixtures/` directory but has the same byte-exactness requirement.
crates/core/algo-consensus-crypto/src/passphrase/wordlist.txt text eol=lf

# Other `include_str!`/`include_bytes!` resources outside `fixtures/`
# that are embedded verbatim into the binary (schema text compared
# byte-for-byte against go-algorand, or served as-is over HTTP) and so
# have the same byte-exactness requirement as fixtures.
crates/node/algo-kmd/src/wallet_schema.sql text eol=lf
crates/node/algo-kmd/swagger.json text eol=lf
crates/node/algo-rest-api/resources/algod.oas2.json text eol=lf

# Baked localnet-rust data dir (TASK-268): genesis.json is COPYed verbatim
# into the Docker image and served byte-for-byte by the live `/genesis` REST
# endpoint (`node.genesis_json()`), and algod.token/algod.admin.token are
# compared byte-exact by go-algorand's own token validation when the same
# files seed a shared-genesis go node (issue #129's dual-node harness). A
# Windows checkout with core.autocrlf=true would otherwise inject CRLF into
# both, corrupting the live REST response and breaking go's strict token
# comparison — pin all four to LF.
docker/localnet-rust/data/genesis.json text eol=lf
docker/localnet-rust/data/genesis.json.in text eol=lf
docker/localnet-rust/data/config.json text eol=lf
docker/localnet-rust/data/algod.token text eol=lf
docker/localnet-rust/data/algod.admin.token text eol=lf

# Binary fixture formats: exempt from all text/eol handling.
*.msgpack binary
*.keyfile binary
*.tx binary
*.db binary
*.sqlite binary
*.sqlite-shm binary
*.sqlite-wal binary

# Go-produced SQLite artifacts (participation key databases captured from
# `goal network create` / `algokey part generate`). `text=auto` above would
# normally detect these as binary via their NUL bytes, but say so
# explicitly: a single byte rewritten by a misconfigured checkout turns a
# format-parity fixture into a corrupt database.
crates/**/fixtures/**/*.partkey binary
crates/**/fixtures/**/*.sqlite binary
