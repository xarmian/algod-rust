-      - name: Create manifest list and push
+      - name: Create GHCR manifest list and push
         working-directory: /tmp/digests
         run: |
           docker buildx imagetools create \
             $(jq -cr '.tags | map("-t " + .) | join(" ")' <<< "$DOCKER_METADATA_OUTPUT_JSON") \
             $(printf '${{ env.REGISTRY }}/${{ env.IMAGE_NAME }}@sha256:%s ' *)
 
-      - name: Inspect image
+      - name: Inspect GHCR image
         run: |
           docker buildx imagetools inspect ${{ env.REGISTRY }}/${{ env.IMAGE_NAME }}:${{ steps.meta.outputs.version }}
 
+      - name: Extract Docker Hub metadata
+        if: needs.prepare.outputs.has_dockerhub == 'true'
+        id: meta_dockerhub
+        uses: docker/metadata-action@v5
+        with:
+          images: docker.io/${{ secrets.DOCKERHUB_USERNAME }}/${{ env.DOCKERHUB_IMAGE }}
+          flavor: |
+            latest=false
+            suffix=${{ matrix.suffix }}
+          tags: |
+            type=ref,event=branch,enable=${{ needs.prepare.outputs.is_main_push == 'true' }}
+            type=raw,value=latest,enable=${{ needs.prepare.outputs.is_main_push == 'true' }}
+            type=raw,value=stable,enable=${{ needs.prepare.outputs.is_stable_tag == 'true' }}
+            type=raw,value=beta,enable=${{ needs.prepare.outputs.is_beta_tag == 'true' }}
+            type=raw,value=nightly,enable=${{ needs.prepare.outputs.is_nightly == 'true' }}
+            type=raw,value=${{ needs.prepare.outputs.short_sha }}-nightly,enable=${{ needs.prepare.outputs.is_nightly == 'true' }}
+            type=semver,pattern={{version}}
+            type=semver,pattern={{major}}.{{minor}}
+            type=raw,value=${{ needs.prepare.outputs.pin_tag }},enable=${{ needs.prepare.outputs.is_main_push == 'true' || needs.prepare.outputs.is_stable_tag == 'true' }}
+            type=sha,format=short,prefix=sha-
+
+      - name: Create Docker Hub manifest list and push
+        if: needs.prepare.outputs.has_dockerhub == 'true'
+        working-directory: /tmp/digests
+        run: |
+          docker buildx imagetools create \
+            $(jq -cr '.tags | map("-t " + .) | join(" ")' <<< "$DOCKER_METADATA_OUTPUT_JSON") \
+            $(printf 'docker.io/${{ secrets.DOCKERHUB_USERNAME }}/${{ env.DOCKERHUB_IMAGE }}@sha256:%s ' *)
+
+      - name: Inspect Docker Hub image
+        if: needs.prepare.outputs.has_dockerhub == 'true'
+        run: |
+          docker buildx imagetools inspect docker.io/${{ secrets.DOCKERHUB_USERNAME }}/${{ env.DOCKERHUB_IMAGE }}:${{ steps.meta_dockerhub.outputs.version }}
+
   pr-check:
     name: PR build check (${{ matrix.target }})
     if: github.event_name == 'pull_request'
