@@ -231,6 +258,27 @@ jobs:
           username: ${{ github.actor }}
           password: ${{ secrets.GITHUB_TOKEN }}
 
+      - name: Log in to Docker Hub
+        if: needs.prepare.outputs.has_dockerhub == 'true'
+        uses: docker/login-action@v3
+        with:
+          username: ${{ secrets.DOCKERHUB_USERNAME }}
+          password: ${{ secrets.DOCKERHUB_TOKEN }}
+
+      - name: Determine target image names
+        id: image_names
+        # A single build below pushes the same digest to every registry
+        # named here — buildx pushes identical manifest bytes to each, so
+        # the resulting digest is the same across registries (content-
+        # addressed), which is what lets `merge` reference it per-registry
+        # without any cross-registry blob copy.
+        run: |
+          names="${{ env.REGISTRY }}/${{ env.IMAGE_NAME }}"
+          if [ "${{ needs.prepare.outputs.has_dockerhub }}" = "true" ]; then
+            names="$names,docker.io/${{ secrets.DOCKERHUB_USERNAME }}/${{ env.DOCKERHUB_IMAGE }}"
+          fi
+          echo "list=$names" >> "$GITHUB_OUTPUT"
+
       - name: Extract labels
         id: meta
         uses: docker/metadata-action@v5
