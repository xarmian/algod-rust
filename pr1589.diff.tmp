@@ -186,6 +200,19 @@ jobs:
             echo "short_sha=${GITHUB_SHA:0:7}"
           } >> "$GITHUB_OUTPUT"
 
+      - name: Check for Docker Hub credentials
+        id: dockerhub
+        # Docker Hub publishing is entirely opt-in: if DOCKERHUB_USERNAME /
+        # DOCKERHUB_TOKEN aren't set (the default for a fresh fork), every
+        # Docker Hub step downstream is skipped and only GHCR is published.
+        # See docs/DOCKER_CI.md for what to configure.
